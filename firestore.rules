rules_version = '2';
// =====================================================================
// Coffee & Deals — Firestore Security Rules (merged: Website + RealtyCRM)
//
//  PUBLIC (no login):
//    • read projects / inventory / approved testimonials
//    • create/merge their own enquiry (a lead) — constrained shape only
//    • submit an (unapproved) testimonial
//  ADMIN (that's you — signed in with an authorised email, or a UID listed
//         in /admins): full read/write, including the CRM document crm/state.
//
//  Change the email list below to add teammates. This is what actually keeps
//  strangers out — enforced on Google's servers, not in the browser.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null &&
         request.auth.token.email in ["ashishsharma8055@gmail.com"]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---- CRM data (RealtyCRM stores everything in the single doc crm/state) ----
    match /crm/{docId} {
      allow read, write: if isAdmin();
    }

    // ---- Public catalog ----
    match /projects/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /inventory/{id}  { allow read: if true; allow write: if isAdmin(); }

    // ---- Website leads (the bridge into the CRM) ----
    // Visitors create or merge ONE enquiry document keyed by their lead code.
    // Only you can read, edit or delete them.
    match /enquiries/{id} {
      allow create, update: if
           request.resource.data.keys().hasOnly(
             ['user','mobile','code','status','createdTs','ts','interests','agent'])
        && request.resource.data.user is string
        && request.resource.data.user.size() < 80
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() < 20;
      allow read, delete: if isAdmin();
    }

    // ---- Channel partners ----
    match /partners/{id}   { allow read, write: if isAdmin(); }

    // ---- Testimonials: public can submit (unapproved); you moderate ----
    // The PUBLIC doc must NOT contain raw contact details — only masked hints.
    // Raw mobile/email go to the admin-only `testimonial_contacts` collection below.
    match /testimonials/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
      // Admin can write freely; the PUBLIC submission path is tightly constrained and
      // must NOT contain raw personal contact fields (only masked hints).
      allow create: if isAdmin() || (
             request.resource.data.approved == false
          && request.resource.data.name is string
          && request.resource.data.name.size() < 80
          && request.resource.data.text is string
          && request.resource.data.text.size() < 600
          && !('mobile' in request.resource.data)
          && !('email' in request.resource.data)
          && request.resource.data.keys().hasOnly(
               ['name','role','text','rating','who','mobileMasked','emailMasked','approved','ts'])
        );
    }

    // ---- Testimonial full contact (private): visitors may submit, ONLY you can read.
    //      Mirrors the enquiries pattern so real mobile/email never become public.
    match /testimonial_contacts/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
             request.resource.data.name is string
          && request.resource.data.name.size() < 80
          && request.resource.data.keys().hasOnly(['name','mobile','email','who','ts'])
        );
    }

    // ---- Admin-only support collections (used by the built-in admin panel) ----
    match /customers/{id}  { allow read, write: if isAdmin(); }
    match /tasks/{id}      { allow read, write: if isAdmin(); }
    match /settings/{id}   { allow read, write: if isAdmin(); }

    // ---- AI voice calling (only you can queue/read; the Cloud Function handles dialing) ----
    match /call_queue/{id}      { allow read, write: if isAdmin(); }
    match /call_history/{id}    { allow read, write: if isAdmin(); }
    match /call_dnc/{id}        { allow read, write: if isAdmin(); }
    match /reminders_sent/{id}  { allow read, write: if isAdmin(); }

    // ---- Admin allow-list (optional legacy path; email list above is primary) ----
    match /admins/{uid}    { allow read: if request.auth != null; allow write: if false; }
  }
}
